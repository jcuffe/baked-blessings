# Bakehouse local environment. `pnpm bootstrap` copies this to .env and adds keys
# that are missing later. Values here are for local development only; staging and
# prod values live in Pulumi config (infra/README.md).
#
# `pnpm dev` reads this file directly. Under `pnpm dev:shopify` the Shopify CLI
# injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES for the
# linked app, and those win over the placeholders below.

# Postgres from docker-compose.yml (host port BAKEHOUSE_PG_PORT, default 55432).
DATABASE_URL=postgres://bakehouse:bakehouse@localhost:55432/bakehouse

# Placeholders so the app boots without a linked Shopify app. Admin pages (/app)
# need `pnpm dev:shopify`; /healthz and the storefront API work without it.
SHOPIFY_API_KEY=local-placeholder
SHOPIFY_API_SECRET=local-placeholder
SHOPIFY_APP_URL=http://localhost:3001
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_orders,read_customers,write_customers,read_shipping,write_shipping
# The dev store, e.g. baked-blessings-dev.myshopify.com.
SHOP_DOMAIN=

# Storefront -> Bakehouse request signing: comma-separated keyId:secret pairs, so a
# key can be rotated. Must contain BAKEHOUSE_KEY_ID:BAKEHOUSE_HMAC_SECRET from
# apps/storefront/.env.
STOREFRONT_HMAC_SECRETS=local:local-dev-only-hmac-secret
# Signs the hidden _slot cart-line property.
SLOT_SIGNING_SECRET=local-dev-only-slot-secret

# v1 runs the pg-boss worker inside the web process.
WORKER_MODE=inline

# Optional: leave empty to skip sending. Use test credentials only.
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
