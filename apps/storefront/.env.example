# Storefront local environment, read by MiniOxygen (`shopify hydrogen dev`).
# `pnpm bootstrap` copies this to .env, generates SESSION_SECRET and adds keys that
# are missing later.
#
# Leave the Shopify storefront keys unset to browse mock.shop. Once linked,
# `pnpm shopify hydrogen env pull` merges PUBLIC_STORE_DOMAIN,
# PUBLIC_STOREFRONT_API_TOKEN and friends into this file. It writes secret
# variables (such as SESSION_SECRET) as empty strings; `pnpm bootstrap` refills
# them.

# Signs the Hydrogen session cookie. Generated by `pnpm bootstrap`.
SESSION_SECRET=

# Bakehouse API (called server-side only). Must match one keyId:secret pair in
# STOREFRONT_HMAC_SECRETS in apps/bakehouse/.env.
BAKEHOUSE_API_URL=http://localhost:3001
BAKEHOUSE_KEY_ID=local
BAKEHOUSE_HMAC_SECRET=local-dev-only-hmac-secret
